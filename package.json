{
  "name": "mr-task-dashboard",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:shared": "pnpm --filter @mrdash/shared build",
    "dev": "pnpm build:shared && pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "test": "pnpm build:shared && pnpm -r --workspace-concurrency=1 test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "db:migrate": "pnpm --filter @mrdash/server db:migrate",
    "db:migrate:deploy": "pnpm --filter @mrdash/server db:migrate:deploy",
    "db:seed": "pnpm --filter @mrdash/server db:seed",
    "db:seed:large": "pnpm --filter @mrdash/server db:seed:large",
    "e2e": "echo \"e2e is added in a later phase\"",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
