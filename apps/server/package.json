{
  "name": "@mrdash/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run --coverage",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed/seed.ts",
    "db:seed:large": "tsx --env-file-if-exists=../../.env src/db/seed/seedLarge.ts",
    "bench": "tsx --env-file-if-exists=../../.env src/bench/listBenchmark.ts",
    "explain": "tsx --env-file-if-exists=../../.env src/bench/explain.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.6",
    "@mrdash/shared": "workspace:^",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "pg-boss": "^10.4.2",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "pino-pretty": "^13.1.3",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
