generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

enum Provider {
  GITLAB
  GITHUB
}

enum MrStatus {
  DRAFT
  OPEN
  IN_REVIEW
  MERGED
  CLOSED
}

enum TaskType {
  FEATURE
  TASK
  BUG
}

enum TaskStatus {
  DRAFT
  OPEN
  IN_REVIEW
  MERGED
  CLOSED
  NO_MR
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum ReviewerState {
  REQUESTED
  APPROVED
  CHANGES_REQUESTED
}

model Repository {
  id            String    @id @default(cuid())
  provider      Provider
  externalId    String
  fullPath      String
  webUrl        String
  defaultBranch String    @default("main")
  isActive      Boolean   @default(true)
  lastSyncedAt  DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  mergeRequests MergeRequest[]
  syncRuns      SyncRun[]

  @@unique([provider, externalId])
  @@map("repositories")
}

model GitUser {
  id          String   @id @default(cuid())
  provider    Provider
  externalId  String
  username    String
  displayName String
  avatarUrl   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  authoredMrs MergeRequest[]         @relation("MrAuthor")
  assignedMrs MergeRequest[]         @relation("MrAssignee")
  reviews     MergeRequestReviewer[]

  @@unique([provider, externalId])
  @@map("git_users")
}

model MergeRequest {
  id              String    @id @default(cuid())
  repositoryId    String
  provider        Provider
  externalId      String
  number          Int
  title           String
  description     String?
  status          MrStatus
  isDraft         Boolean   @default(false)
  sourceBranch    String
  targetBranch    String
  url             String
  authorId        String
  assigneeId      String?
  createdAtRemote DateTime  @db.Timestamptz(3)
  updatedAtRemote DateTime  @db.Timestamptz(3)
  mergedAt        DateTime? @db.Timestamptz(3)
  closedAt        DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  repository Repository             @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  author     GitUser                @relation("MrAuthor", fields: [authorId], references: [id])
  assignee   GitUser?               @relation("MrAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reviewers  MergeRequestReviewer[]
  tasks      TaskMergeRequest[]

  @@unique([repositoryId, number])
  @@index([status])
  @@index([targetBranch])
  @@index([assigneeId])
  @@index([updatedAtRemote(sort: Desc)])
  @@index([mergedAt])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("merge_requests")
}

model MergeRequestReviewer {
  mergeRequestId String
  gitUserId      String
  state          ReviewerState @default(REQUESTED)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  mergeRequest MergeRequest @relation(fields: [mergeRequestId], references: [id], onDelete: Cascade)
  gitUser      GitUser      @relation(fields: [gitUserId], references: [id], onDelete: Cascade)

  @@id([mergeRequestId, gitUserId])
  @@index([gitUserId])
  @@map("merge_request_reviewers")
}

model Task {
  id             String      @id @default(cuid())
  title          String
  type           TaskType    @default(TASK)
  status         TaskStatus  @default(NO_MR)
  statusOverride TaskStatus?
  assigneeName   String?
  targetBranch   String?
  notes          String?
  parentId       String?
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  parent        Task?              @relation("TaskChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children      Task[]             @relation("TaskChildren")
  mergeRequests TaskMergeRequest[]

  @@index([parentId])
  @@index([status])
  @@index([targetBranch])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("tasks")
}

model TaskMergeRequest {
  taskId         String
  mergeRequestId String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  mergeRequest MergeRequest @relation(fields: [mergeRequestId], references: [id], onDelete: Cascade)

  @@id([taskId, mergeRequestId])
  @@index([mergeRequestId])
  @@map("task_merge_requests")
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    Provider
  deliveryId  String
  eventType   String
  receivedAt  DateTime  @default(now()) @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)
  error       String?
  payload     Json
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([provider, deliveryId])
  @@index([receivedAt])
  @@map("webhook_events")
}

model SyncRun {
  id            String     @id @default(cuid())
  repositoryId  String
  status        SyncStatus @default(RUNNING)
  startedAt     DateTime   @default(now()) @db.Timestamptz(3)
  finishedAt    DateTime?  @db.Timestamptz(3)
  itemsFetched  Int        @default(0)
  itemsUpserted Int        @default(0)
  error         String?
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, startedAt(sort: Desc)])
  @@map("sync_runs")
}
