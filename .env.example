NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://app:app@localhost:5432/mrdash
DATABASE_URL_TEST=postgresql://app:app@localhost:5432/mrdash_test
APP_TIMEZONE=Asia/Yerevan
SESSION_SECRET=
DASHBOARD_PASSWORD=
# Team sign-in (see docs/AUTH.md). AUTH_MODE: password | oauth | both.
# Unset = oauth when a provider below is configured, otherwise password.
AUTH_MODE=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_CLIENT_ID=      # uses GITLAB_BASE_URL below
GITLAB_OAUTH_CLIENT_SECRET=
# With OAuth on, at least one of these is required (comma-separated, case-insensitive):
AUTH_ALLOWED_USERS=          # usernames or emails; "github:name" / "gitlab:name" limits to one provider
AUTH_ALLOWED_GITHUB_ORG=
AUTH_ALLOWED_GITLAB_GROUP=   # full path, e.g. acme/platform
AUTH_ADMINS=                 # become ADMIN on first login (and are allowed in)
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=                # scope: read_api
GITLAB_WEBHOOK_SECRET=
GITHUB_TOKEN=                # fine-grained, Pull requests: read, Metadata: read
GITHUB_WEBHOOK_SECRET=
STALE_DAYS=7
SYNC_INTERVAL_MINUTES=5
LOG_LEVEL=info
RATE_LIMIT_MAX=300           # requests per minute per client
TRUST_PROXY_HOPS=0         # reverse proxies in front of the API (prod compose sets 1)
